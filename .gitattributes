# Normalize line endings across platforms (reproducible science repo)
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.R     text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.cff   text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

# Binary assets (never touch line endings)
*.png   binary
*.pdf   binary
*.docx  binary
*.gz    binary
*.rds   binary
*.h5    binary
*.h5ad  binary
*.pth   binary
