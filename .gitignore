# Large data files (available from external sources, see README)
*.h5ad
*.h5
*.rds
*.rds.gz
*.pth
*.hdf5

# Raw OSDR data (retrieve from NASA OSDR API)
raw_osdr/
osdr_raw/

# Model weights (retrieve from scPlantLLM repository)
model_params/
*.pth
*.bin

# Intermediate files
*.tmp
*.bak
__pycache__/
*.pyc
.Rhistory
.RData
*.Rproj

# OS files
.DS_Store
Thumbs.db

# Jupyter notebooks (if any)
.ipynb_checkpoints/

# De-sandboxing: generated + large intermediate dirs
work/
atlas/
results/

# Generated figures at repo root (regenerated by the analysis scripts).
# Anchored with a leading slash so tracked manuscript/figures/ and
# track*/figures/ are NOT ignored. Keep the empty dir so scripts can write to it.
/figures/*
!/figures/.gitkeep
